# Backend-only service configuration. Do not prefix secrets with NEXT_PUBLIC_.
ADMIN_PASSWORD=change-me
AUTH_SECRET=generate-a-long-random-value
WEATHER_LOCATION=Leça do Balio
# Calendar via published .ics feed URLs — the low-maintenance alternative to the
# Google OAuth flow below. Nothing here expires or needs refreshing, so there is
# no token to go stale. List one URL per calendar, comma or newline separated,
# and they are merged into a single timeline (e.g. work + personal). Works with
# iCloud "Public Calendar" links, Google "secret address in iCal format", and
# Outlook published calendars — note Google's own feed can lag by hours.
# Treat each URL as a secret: anyone holding it can read that calendar.
# When this is set it takes over from the Google OAuth backend entirely.
CALENDAR_ICS_URLS=
# Apple Reminders, read over iCloud CalDAV. APPLE_REMINDERS_APP_PASSWORD must be
# an app-specific password from appleid.apple.com — iCloud rejects the account
# password once two-factor auth is on. Paste it exactly as Apple shows it.
# APPLE_REMINDERS_LISTS names the lists you want, matched case-insensitively;
# use * for every list (or leave it unset, which means the same — * exists for
# hosts whose environment editor will not accept an empty value).
APPLE_REMINDERS_ID=
APPLE_REMINDERS_APP_PASSWORD=
APPLE_REMINDERS_LISTS=*
# Google Calendar client id/secret + the one-time connect flow live in
# /admin/credentials — no access token belongs here. GOOGLE_CALENDAR_ACCESS_TOKEN
# is only a legacy manual-test fallback; it expires in ~1hr and is not refreshed.
GOOGLE_CALENDAR_ACCESS_TOKEN=
GOOGLE_CALENDAR_ID=primary
# Spotify client credentials + OAuth connection live in /admin/credentials.
# This one-hour access token is only a legacy fallback for manual testing.
SPOTIFY_ACCESS_TOKEN=
COOLIFY_URL=
COOLIFY_TOKEN=
